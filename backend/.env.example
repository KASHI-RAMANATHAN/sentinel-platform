# ============================================================
# Environment configuration for the Behavioral Anomaly Detection
# Platform backend. Copy this file to `.env` and fill in real
# values. NEVER commit the actual `.env` file or service account
# JSON to version control.
# ============================================================

# --- General ---
APP_NAME="Behavioral Anomaly Detection Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- CORS ---
# Comma-will-not-work here; this is parsed as a JSON-style list by pydantic-settings.
# Example: '["http://localhost:3000","https://yourfrontend.com"]'
CORS_ORIGINS=["*"]

# --- Firebase ---
# Path to the downloaded Firebase service account JSON (Project Settings
# > Service Accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firestore collection names
FIRESTORE_LOGS_COLLECTION=logs
FIRESTORE_ALERTS_COLLECTION=alerts
FIRESTORE_PREDICTIONS_COLLECTION=predictions

# --- Auth (placeholder, not yet enforced) ---
FIREBASE_AUTH_ENABLED=false

# --- ML (placeholder) ---
ML_MODEL_PATH=./app/ml/artifacts/
